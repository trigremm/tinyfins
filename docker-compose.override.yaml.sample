# Production override (сервер с hostwide dc-traefik).
# Скопировать в docker-compose.override.yaml (gitignored) — Compose смержит сам:
#   cp docker-compose.override.yaml.sample docker-compose.override.yaml && make r
#
# Traefik маршрутизирует контейнеры сети traefik-public по лейблам;
# TLS выдаёт Let's Encrypt (certResolver задан на entrypoint websecure).

services:
  tinyfins:
    networks:
      - default
      - traefik-public
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.tinyfins.rule=Host(`tinyfins.asmo.su`)'
      - 'traefik.http.routers.tinyfins.entrypoints=websecure'
      - 'traefik.http.services.tinyfins.loadbalancer.server.port=80'

networks:
  traefik-public:
    external: true
